---
import Button from './ui/Button.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import Icon from './ui/Icon.astro';
---

<nav class="fixed top-0 left-0 right-0 z-40 bg-bg/80 backdrop-blur-md border-b border-border" aria-label="Main navigation">
  <div class="container-main">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 text-text-primary hover:opacity-80 transition-opacity" aria-label="Text Count Tools - Home">
        <img src="/favicon.svg" alt="" class="w-8 h-8" aria-hidden="true" />
        <span class="text-heading-lg font-semibold tracking-tight">Text Count Tools</span>
      </a>

      <div class="hidden md:flex items-center gap-1">
        <a href="/tools/word-counter" class="nav-link">Word Counter</a>
        <a href="/tools/reading-time-calculator" class="nav-link">Reading Time</a>
      </div>

      <div class="flex items-center gap-3">
        <ThemeToggle />
        <div class="hidden md:flex items-center gap-2">
          <Button variant="ghost" size="sm" href="/tools/word-counter">
            Try Word Counter
            <Icon name="arrowRight" width="16" height="16" class="ml-1" />
          </Button>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .nav-link {
    border-radius: 9999px;
    padding: 8px 12px;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-text-secondary);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .nav-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-border-soft);
  }
</style>