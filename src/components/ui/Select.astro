---
interface Props {
  id: string;
  label?: string;
  options: Array<{ value: string; label: string }>;
  value?: string;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  hint?: string;
  class?: string;
  name?: string;
}

const {
  id,
  label,
  options,
  value,
  required = false,
  disabled = false,
  error,
  hint,
  class: className = '',
  name,
} = Astro.props;

const selectId = id;
const errorId = error ? `${id}-error` : undefined;
const hintId = hint ? `${id}-hint` : undefined;
const describedBy = [errorId, hintId].filter(Boolean).join(' ') || undefined;
---

<div class="w-full {className}">
  {label && (
    <label for={selectId} class="block text-label-sm text-text-primary mb-2">
      {label}
      {required && <span class="text-error ml-1" aria-hidden="true">*</span>}
    </label>
  )}
  <select
    id={selectId}
    value={value}
    required={required}
    disabled={disabled}
    name={name}
    class="input-text w-full appearance-none bg-[url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2216%22 height=%2216%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%234d4d4d%22 stroke-width=%222%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22%3E%3Cpath d=%22m6 9 6 6 6-6%22/%3E%3C/svg%3E')] bg-no-repeat bg-right-3 pr-10"
    aria-invalid={error ? 'true' : 'false'}
    aria-describedby={describedBy}
    aria-required={required}
  >
    {options.map(opt => (
      <option value={opt.value} selected={value === opt.value}>
        {opt.label}
      </option>
    ))}
  </select>
  {error && (
    <p id={errorId} class="mt-2 text-body-sm text-error" role="alert">
      {error}
    </p>
  )}
  {hint && !error && (
    <p id={hintId} class="mt-2 text-body-sm text-text-muted">
      {hint}
    </p>
  )}
</div>