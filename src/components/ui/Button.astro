---
interface Props {
  children: import('astro').AstroComponentInstance;
  variant?: 'primary' | 'secondary' | 'ghost' | 'category';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  'aria-label'?: string;
  'data-theme-toggle'?: boolean;
}

const {
  children,
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className = '',
  'aria-label': ariaLabel,
  'data-theme-toggle': isThemeToggle = false,
} = Astro.props;

const isLink = !!href;
const Tag = isLink ? 'a' : 'button';

const baseClasses = 'inline-flex items-center justify-center font-sans transition-all duration-150 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-bg disabled:opacity-50 disabled:cursor-not-allowed';

const variantClasses = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  ghost: 'btn-ghost-sm',
  category: 'btn-category-pill',
};

const sizeClasses = {
  sm: 'text-button-md h-8 px-3',
  md: 'text-button-lg h-10 px-[14px]',
  lg: 'text-button-lg h-12 px-6',
};

const classes = [
  baseClasses,
  variantClasses[variant],
  sizeClasses[size],
  className,
].filter(Boolean).join(' ');
---

<{Tag}
  href={href}
  type={isLink ? undefined : type}
  disabled={disabled && !isLink}
  class={classes}
  aria-label={ariaLabel}
  aria-disabled={disabled}
  data-theme-toggle={isThemeToggle}
  role={isLink ? undefined : 'button'}
>
  {children}
</{Tag}>