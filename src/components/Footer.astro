---
import Icon from './ui/Icon.astro';
---

<footer class="bg-bg border-t border-border" role="contentinfo">
  <div class="container-main py-28 lg:py-48">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 lg:gap-16 px-4 sm:px-6 lg:px-8">
      <div class="col-span-2 md:col-span-1 py-8 lg:py-12">
        <a href="/" class="flex items-center gap-2 text-text-primary mb-6" aria-label="Text Count Tools - Home">
          <span class="text-heading-md font-semibold tracking-tight">Text Count Tools</span>
        </a>
        <p class="text-body-md text-text-secondary">
          Free, fast, and private text analysis tools that run entirely in your browser.
        </p>
      </div>

      <nav aria-label="Tools" class="py-8 lg:py-12">
        <h3 class="text-label-sm text-text-primary mb-4">Tools</h3>
        <ul class="space-y-3">
          <li><a href="/tools/word-counter" class="text-body-md text-text-secondary hover:text-text-primary transition-colors">Word Counter</a></li>
          <li><a href="/tools/reading-time-calculator" class="text-body-md text-text-secondary hover:text-text-primary transition-colors">Reading Time Calculator</a></li>
        </ul>
      </nav>

      <nav aria-label="Resources" class="py-8 lg:py-12">
        <h3 class="text-label-sm text-text-primary mb-4">Resources</h3>
        <ul class="space-y-3">
          <li><a href="#faq" class="text-body-md text-text-secondary hover:text-text-primary transition-colors">FAQ</a></li>
          <li><a href="/about" class="text-body-md text-text-secondary hover:text-text-primary transition-colors">About Us</a></li>
          <li><a href="/privacy" class="text-body-md text-text-secondary hover:text-text-primary transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-body-md text-text-secondary hover:text-text-primary transition-colors">Terms of Service</a></li>
          <li><a href="/contact" class="text-body-md text-text-secondary hover:text-text-primary transition-colors">Contact Us</a></li>
        </ul>
      </nav>

      <nav aria-label="Connect" class="py-8 lg:py-12">
        <h3 class="text-label-sm text-text-primary mb-4">Connect</h3>
        <ul class="space-y-3">
          <li>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-body-md text-text-secondary hover:text-text-primary transition-colors">
              <Icon name="externalLink" width="16" height="16" />
              GitHub
            </a>
          </li>
          <li>
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-body-md text-text-secondary hover:text-text-primary transition-colors">
              <Icon name="externalLink" width="16" height="16" />
              Twitter
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-24 lg:mt-32 pt-14 pb-16 border-t border-border">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-body-sm text-text-muted">
          © {new Date().getFullYear()} Text Count Tools. All rights reserved.
        </p>
        <p class="text-body-sm text-text-muted">
          Made with <Icon name="heart" width="14" height="14" class="text-text-secondary" /> using Astro & Tailwind CSS
        </p>
      </div>
    </div>
  </div>
</footer>