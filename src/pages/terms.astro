---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Terms of Service | Text Count Tools" 
  description="Terms of Service for Text Count Tools. Free text analysis tools with no warranties, no liability and no data collection."
  canonicalURL="https://textcounttools.com/terms"
  ogImage="https://textcounttools.com/og-image.png"
  ogType="website"
>
  <Navigation />

  <main id="main-content" class="pt-16 min-h-screen">
    <section class="section-padding-lg mesh-gradient" aria-labelledby="terms-heading">
      <div class="container-main">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-mono-eyebrow text-text-muted mb-4">Legal</p>
          <h1 id="terms-heading" class="text-display-xl text-text-primary mb-6 leading-tight">
            Terms of Service
          </h1>
          <p class="text-body-lg text-text-secondary mb-8 prose-full">
            Last updated: November 2024
          </p>
        </div>
      </div>
    </section>

    <section class="section-padding" aria-labelledby="terms-content">
      <div class="container-main">
        <div class="max-w-4xl mx-auto prose-full space-y-8">
          <section aria-labelledby="acceptance-heading">
            <h2 id="acceptance-heading" class="text-heading-lg text-text-primary mb-4">Acceptance of Terms</h2>
            <p class="text-body-lg text-text-secondary">
              By accessing or using Text Count Tools (<strong>textcounttools.com</strong>), you agree to be bound by these Terms of Service. If you disagree with any part of these terms, please do not use our tools.
            </p>
          </section>

          <section aria-labelledby="description-heading">
            <h2 id="description-heading" class="text-heading-lg text-text-primary mb-4">Description of Service</h2>
            <p class="text-body-lg text-text-secondary">
              Text Count Tools provides free, client-side text analysis utilities including:
            </p>
            <ul class="list-disc list-inside space-y-2 text-body-md text-text-secondary ml-4">
<li><strong>Word Counter</strong>, Counts words, characters, sentences, paragraphs, lines and calculates averages</li>
<li><strong>Reading Time Calculator</strong>, Estimates reading and speaking time with configurable WPM presets</li>
<li><strong>File Upload</strong>, Extract text from PDF, DOCX, TXT and Markdown files (client-side only)</li>
            </ul>
            <p class="text-body-lg text-text-secondary mt-4">
              All processing occurs in your browser. No text is transmitted to our servers.
            </p>
          </section>

          <section aria-labelledby="license-heading">
            <h2 id="license-heading" class="text-heading-lg text-text-primary mb-4">License Grant</h2>
            <p class="text-body-lg text-text-secondary">
              We grant you a worldwide, royalty-free, non-exclusive license to:
            </p>
            <ul class="list-disc list-inside space-y-2 text-body-md text-text-secondary ml-4">
              <li>Use Text Count Tools for personal or commercial purposes</li>
              <li>Process unlimited amounts of text through our tools</li>
              <li>Export and use statistics generated by our tools</li>
            </ul>
            <p class="text-body-lg text-text-secondary mt-4">
              You may not: reverse engineer, decompile, or attempt to extract our source code; use our tools for illegal purposes; or attempt to disrupt, damage, or impair the service.
            </p>
          </section>

          <section aria-labelledby="privacy-heading">
            <h2 id="privacy-heading" class="text-heading-lg text-text-primary mb-4">Privacy & Data</h2>
            <p class="text-body-lg text-text-secondary">
              Our <a href="/privacy" class="text-link underline hover:text-link-deep">Privacy Policy</a> explains how we handle data. Summary: <strong>we don't collect your text</strong>. All processing is client-side. No accounts, no tracking, no data collection.
            </p>
          </section>

          <section aria-labelledby="disclaimer-heading">
            <h2 id="disclaimer-heading" class="text-heading-lg text-text-primary mb-4">Disclaimer of Warranties</h2>
            <p class="text-body-lg text-text-secondary">
              TEXT COUNT TOOLS IS PROVIDED "AS IS" AND "AS AVAILABLE" WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO:
            </p>
            <ul class="list-disc list-inside space-y-2 text-body-md text-text-secondary ml-4">
              <li>Implied warranties of merchantability, fitness for a particular purpose, or non-infringement</li>
              <li>Warranties that the service will be uninterrupted, error-free, or secure</li>
              <li>Warranties regarding accuracy, completeness, or reliability of results</li>
            </ul>
            <p class="text-body-lg text-text-secondary mt-4">
              Text analysis algorithms (word counting, sentence detection, reading time estimation) follow standard conventions but may not match every style guide or edge case. Results are provided for informational purposes only.
            </p>
          </section>

          <section aria-labelledby="limitation-heading">
            <h2 id="limitation-heading" class="text-heading-lg text-text-primary mb-4">Limitation of Liability</h2>
            <p class="text-body-lg text-text-secondary">
              TO THE MAXIMUM EXTENT PERMITTED BY LAW, TEXT COUNT TOOLS AND ITS CREATORS SHALL NOT BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES, INCLUDING BUT NOT LIMITED TO:
            </p>
            <ul class="list-disc list-inside space-y-2 text-body-md text-text-secondary ml-4">
              <li>Loss of data, text, or content</li>
              <li>Loss of profits, revenue, or business opportunities</li>
              <li>Service interruptions or downtime</li>
              <li>Errors or inaccuracies in text analysis results</li>
            </ul>
            <p class="text-body-lg text-text-secondary mt-4">
              Our total liability for any claim arising from your use of Text Count Tools shall not exceed the amount you paid for the service (which is $0).
            </p>
          </section>

          <section aria-labelledby="indemnification-heading">
            <h2 id="indemnification-heading" class="text-heading-lg text-text-primary mb-4">Indemnification</h2>
            <p class="text-body-lg text-text-secondary">
              You agree to indemnify and hold harmless Text Count Tools and its creators from any claims, damages, losses, or expenses (including reasonable attorneys' fees) arising from your use of the service or violation of these Terms.
            </p>
          </section>

          <section aria-labelledby="intellectual-property-heading">
            <h2 id="intellectual-property-heading" class="text-heading-lg text-text-primary mb-4">Intellectual Property</h2>
            <p class="text-body-lg text-text-secondary">
              Text Count Tools, its design, code and branding are the property of its creators. You may not copy, reproduce, or distribute the service's code or design without permission. The text you process through our tools remains your intellectual property, we claim no rights to it.
            </p>
          </section>

          <section aria-labelledby="modifications-heading">
            <h2 id="modifications-heading" class="text-heading-lg text-text-primary mb-4">Modifications to Service</h2>
            <p class="text-body-lg text-text-secondary">
              We reserve the right to modify, suspend, or discontinue Text Count Tools (or any features) at any time without notice. We will not be liable for any modification, suspension, or discontinuance.
            </p>
          </section>

          <section aria-labelledby="termination-heading">
            <h2 id="termination-heading" class="text-heading-lg text-text-primary mb-4">Termination</h2>
            <p class="text-body-lg text-text-secondary">
              We may terminate or suspend your access to Text Count Tools at our sole discretion, without prior notice, for conduct we believe violates these Terms or is harmful to other users, us, or third parties.
            </p>
          </section>

          <section aria-labelledby="governing-law-heading">
            <h2 id="governing-law-heading" class="text-heading-lg text-text-primary mb-4">Governing Law</h2>
            <p class="text-body-lg text-text-secondary">
              These Terms shall be governed by and construed in accordance with the laws of the jurisdiction where Text Count Tools is operated, without regard to conflict of law principles.
            </p>
          </section>

          <section aria-labelledby="contact-heading">
            <h2 id="contact-heading" class="text-heading-lg text-text-primary mb-4">Contact</h2>
            <p class="text-body-lg text-text-secondary">
              Questions about these Terms? <a href="/contact" class="text-link underline hover:text-link-deep">Contact us</a>.
            </p>
          </section>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>