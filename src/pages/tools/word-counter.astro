---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/ui/Button.astro';
import Textarea from '../../components/ui/Textarea.astro';
import Card from '../../components/ui/Card.astro';
import Icon from '../../components/ui/Icon.astro';
---

<Layout 
  title="Word Counter - Free Online Word Count Tool | Text Count Tools" 
  description="Free online word counter with live statistics. Count words, characters, sentences, paragraphs instantly. Upload PDF, DOCX, TXT, MD files. 100% private, works offline, no limits."
  canonicalURL="https://textcounttools.com/tools/word-counter"
  ogImage="https://textcounttools.com/og-image.png"
  ogType="website"
>
  <Navigation />

  <main id="main-content" class="pt-16 min-h-screen">
    <section class="section-padding-lg" aria-labelledby="hero-heading">
      <div class="container-main">
        <div class="max-w-4xl mx-auto text-center">
          <p class="text-mono-eyebrow text-text-muted mb-4">Flagship Tool</p>
          <h1 id="hero-heading" class="text-display-xl text-text-primary mb-6 leading-tight">
            Word Counter
          </h1>
          <p class="text-body-lg text-text-secondary mb-8 prose-full">
            Paste text, type directly, or upload files to get instant word count and detailed text statistics. Everything runs locally in your browser, your data never leaves your device.
          </p>
        </div>
      </div>
    </section>

    <section class="section-padding" aria-labelledby="tool-heading">
      <div class="container-main">
        <div class="space-y-8 lg:grid lg:grid-cols-[1fr_300px] lg:gap-12">
          <div class="space-y-6 w-full max-w-5xl min-w-0">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
              <h2 id="tool-heading" class="text-heading-md text-text-primary">Input Text</h2>
              <div class="flex items-center gap-2 flex-wrap">
                <button
                  id="clear-btn"
                  type="button"
                  class="btn-ghost-sm text-button-md h-8 px-3 inline-flex items-center gap-1"
                  aria-label="Clear all text"
                >
                  <Icon name="trash" width="16" height="16" />
                  Clear
                </button>
                <button
                  id="upload-btn"
                  type="button"
                  class="btn-ghost-sm text-button-md h-8 px-3 inline-flex items-center gap-1"
                  aria-label="Upload a file"
                >
                  <Icon name="upload" width="16" height="16" />
                  Upload
                </button>
                <button
                  id="download-stats-btn"
                  type="button"
                  class="btn-primary text-button-md h-8 px-3 inline-flex items-center gap-1"
                  aria-label="Download statistics as JSON"
                >
                  <Icon name="download" width="16" height="16" />
                  Download Stats
                </button>
              </div>
            </div>

            <div class="relative">
              <div id="text-view">
                <Textarea
                  id="text-input"
                  placeholder="Paste your text here, type directly, or drag & drop a file..."
                  rows={16}
                  data-autosave
                  hint="Supports TXT, MD, PDF and DOCX files. Drag & drop or click Upload button."
                />
              </div>
              <div id="pdf-view" class="hidden">
                <div class="relative bg-bg-elevated border border-border rounded-md min-h-[400px] max-h-[700px] overflow-auto">
                  <div id="pdf-container" class="py-4 space-y-4"></div>
                  <div id="pdf-loading" class="absolute inset-0 flex items-center justify-center bg-bg/80">
                    <div class="animate-spin rounded-full h-8 w-8 border-2 border-link border-t-transparent"></div>
                  </div>
                  <div id="pdf-error" class="hidden absolute inset-0 flex items-center justify-center bg-bg/90 p-4 text-center">
                    <p class="text-text-secondary">Failed to load PDF</p>
                  </div>
                </div>
<div class="flex items-center justify-between mt-3 px-1">
                  <div class="flex items-center gap-2">
                    <span id="pdf-page-info" class="text-body-sm text-text-muted min-w-[80px] text-center">Loading...</span>
                  </div>
                  <div class="flex items-center gap-1">
                    <button id="zoom-out" type="button" class="btn-ghost-sm text-button-sm h-7 px-2 inline-flex items-center" aria-label="Zoom out">
                      <Icon name="zoom-out" width="16" height="16" />
                    </button>
                    <input id="pdf-zoom" type="number" class="input-text text-body-sm h-7 w-20 text-center" value="100" min="50" max="300" step="25" aria-label="Zoom percentage">
                    <button id="zoom-in" type="button" class="btn-ghost-sm text-button-sm h-7 px-2 inline-flex items-center" aria-label="Zoom in">
                      <Icon name="zoom-in" width="16" height="16" />
                    </button>
                    <span class="text-body-sm text-text-muted">%</span>
                  </div>
                </div>
              </div>
              <div
                id="drop-zone"
                class="absolute inset-0 border-2 border-dashed border-border rounded-md flex items-center justify-center transition-colors bg-bg-elevated/50 hidden"
                aria-hidden="true"
              >
                <div class="text-center p-8 prose-full">
                  <Icon name="upload" width="48" height="48" class="mx-auto mb-4 text-text-muted" />
                  <p class="text-body-md text-text-secondary">Drag & drop a file here</p>
                  <p class="text-body-sm text-text-muted mt-1">TXT, MD, PDF, DOCX (max 10MB)</p>
                </div>
              </div>
              <input
                type="file"
                id="file-input"
                accept="text/plain,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,.txt,.md,.markdown,.pdf,.docx"
                class="hidden"
                aria-label="Upload a text file"
              />
            </div>

            <div id="file-info" class="hidden flex items-center justify-between p-4 bg-bg-elevated border border-border rounded-md">
              <div class="flex items-center gap-3">
                <Icon name="file" width="20" height="20" class="text-text-muted" />
                <div>
                  <p id="file-name" class="text-body-md text-text-primary"></p>
                  <p id="file-size" class="text-body-sm text-text-muted"></p>
                </div>
              </div>
              <button
                id="remove-file-btn"
                type="button"
                class="btn-ghost-sm text-button-md h-8 px-3 inline-flex items-center"
                aria-label="Remove uploaded file"
              >
                <Icon name="trash" width="16" height="16" />
              </button>
            </div>
</div>
          <aside class="space-y-6 lg:w-96 shrink-0" aria-labelledby="stats-heading">
            <div id="stats-loading" class="card-feature p-6" aria-live="polite">
              <div class="flex items-center gap-4">
                <div class="animate-pulse bg-border-soft rounded-full h-8 w-24"></div>
                <div class="animate-pulse bg-border-soft rounded-full h-8 w-32"></div>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-4">
                <div class="animate-pulse bg-border-soft rounded-md h-16"></div>
                <div class="animate-pulse bg-border-soft rounded-md h-16"></div>
                <div class="animate-pulse bg-border-soft rounded-md h-16"></div>
                <div class="animate-pulse bg-border-soft rounded-md h-16"></div>
              </div>
            </div>

            <div id="stats-content" class="hidden">
              <Card variant="default" padding="lg">
                <h3 id="stats-heading" class="text-heading-md text-text-primary mb-6">Statistics</h3>
                <dl class="space-y-4" id="stats-list">
                  <div class="grid grid-cols-2 gap-4">
                    <div class="bg-bg p-4 rounded-md">
                      <dt class="text-body-sm text-text-muted mb-1">Words</dt>
                      <dd id="stat-words" class="text-3xl font-semibold text-text-primary tabular-nums">0</dd>
                    </div>
                    <div class="bg-bg p-4 rounded-md">
                      <dt class="text-body-sm text-text-muted mb-1">Characters</dt>
                      <dd id="stat-chars" class="text-3xl font-semibold text-text-primary tabular-nums">0</dd>
                    </div>
                  </div>
                  <div class="grid grid-cols-2 gap-4">
                    <div class="bg-bg p-4 rounded-md">
                      <dt class="text-body-sm text-text-muted mb-1">Chars (no spaces)</dt>
                      <dd id="stat-chars-no-spaces" class="text-3xl font-semibold text-text-primary tabular-nums">0</dd>
                    </div>
                    <div class="bg-bg p-4 rounded-md">
                      <dt class="text-body-sm text-text-muted mb-1">Sentences</dt>
                      <dd id="stat-sentences" class="text-3xl font-semibold text-text-primary tabular-nums">0</dd>
                    </div>
                  </div>
                  <div class="grid grid-cols-2 gap-4">
                    <div class="bg-bg p-4 rounded-md">
                      <dt class="text-body-sm text-text-muted mb-1">Paragraphs</dt>
                      <dd id="stat-paragraphs" class="text-3xl font-semibold text-text-primary tabular-nums">0</dd>
                    </div>
                    <div class="bg-bg p-4 rounded-md">
                      <dt class="text-body-sm text-text-muted mb-1">Lines</dt>
                      <dd id="stat-lines" class="text-3xl font-semibold text-text-primary tabular-nums">0</dd>
                    </div>
                  </div>
                  <div class="grid grid-cols-2 gap-4 pt-2 border-t border-border">
                    <div class="bg-bg p-4 rounded-md">
                      <dt class="text-body-sm text-text-muted mb-1">Avg Word Length</dt>
                      <dd id="stat-avg-word" class="text-3xl font-semibold text-text-primary tabular-nums">0</dd>
                    </div>
                    <div class="bg-bg p-4 rounded-md">
                      <dt class="text-body-sm text-text-muted mb-1">Avg Sentence Length</dt>
                      <dd id="stat-avg-sentence" class="text-3xl font-semibold text-text-primary tabular-nums">0</dd>
                    </div>
                  </div>
                </dl>

                <div class="mt-6 flex flex-wrap gap-3">
                  <button
                    id="copy-stats-btn"
                    type="button"
                    class="btn-secondary text-button-md h-8 px-3 inline-flex items-center gap-1"
                    aria-label="Copy statistics to clipboard"
                  >
                    <Icon name="copy" width="16" height="16" />
                    Copy Stats
                  </button>
                  <button
                    id="copy-text-btn"
                    type="button"
                    class="btn-ghost-sm text-button-md h-8 px-3 inline-flex items-center gap-1"
                    aria-label="Copy input text to clipboard"
                  >
                    <Icon name="copy" width="16" height="16" />
                    Copy Text
                  </button>
                </div>
              </Card>

              <div id="toast" class="hidden fixed bottom-6 right-6 z-50 bg-text-primary text-bg px-4 py-3 rounded-md shadow-floating flex items-center gap-2" role="alert" aria-live="polite"></div>
            </div>
          </aside>
        </div>
      </div>
    </section>

<section id="faq" class="section-padding bg-bg-elevated border-y border-border" aria-labelledby="faq-heading">
      <div class="container-main">
        <div class="max-w-4xl mx-auto text-center mb-12">
          <p class="text-mono-eyebrow text-text-muted mb-3">Frequently Asked Questions</p>
          <h2 id="faq-heading" class="text-heading-lg text-text-primary mb-4">Word Counter Questions</h2>
        </div>

        <dl class="space-y-4 max-w-4xl mx-auto">
          <div class="card-feature">
            <dt>
              <details class="group">
                <summary class="flex items-center justify-between cursor-pointer list-none p-4 text-heading-md text-text-primary">
                  What statistics does the Word Counter show?
                  <Icon name="arrowRight" width="20" height="20" class="text-text-muted group-open:rotate-90 transition-transform" />
                </summary>
                <dd class="px-4 pb-4 text-body-md text-text-secondary prose-full">
                  The Word Counter displays: word count, character count (with and without spaces), sentence count, paragraph count, line count, average word length and average sentence length. All statistics update in real-time as you type or paste text.
                </dd>
              </details>
            </dt>
          </div>

          <div class="card-feature">
            <dt>
              <details class="group">
                <summary class="flex items-center justify-between cursor-pointer list-none p-4 text-heading-md text-text-primary">
                  Can I upload PDF and Word documents?
                  <Icon name="arrowRight" width="20" height="20" class="text-text-muted group-open:rotate-90 transition-transform" />
                </summary>
                <dd class="px-4 pb-4 text-body-md text-text-secondary prose-full">
                  Yes. Supports TXT, Markdown (MD), PDF and DOCX files up to 10MB. Text is extracted client-side using pdfjs-dist for PDFs and mammoth.js for DOCX, no server upload.
                </dd>
              </details>
            </dt>
          </div>

          <div class="card-feature">
            <dt>
              <details class="group">
                <summary class="flex items-center justify-between cursor-pointer list-none p-4 text-heading-md text-text-primary">
                  How do I copy or export statistics?
                  <Icon name="arrowRight" width="20" height="20" class="text-text-muted group-open:rotate-90 transition-transform" />
                </summary>
                <dd class="px-4 pb-4 text-body-md text-text-secondary prose-full">
                  Click "Copy Stats" to copy all metrics as JSON to clipboard, or "Download Stats" to save a .json file with timestamp. Useful for reports or record-keeping.
                </dd>
              </details>
            </dt>
          </div>

          <div class="card-feature">
            <dt>
              <details class="group">
                <summary class="flex items-center justify-between cursor-pointer list-none p-4 text-heading-md text-text-primary">
                  Does the Word Counter auto-save my text?
                  <Icon name="arrowRight" width="20" height="20" class="text-text-muted group-open:rotate-90 transition-transform" />
                </summary>
                <dd class="px-4 pb-4 text-body-md text-text-secondary prose-full">
                  Yes. Text is auto-saved to localStorage as you type. It persists across browser sessions and page refreshes. Use "Clear" button to reset both text and saved data.
                </dd>
              </details>
            </dt>
          </div>

          <div class="card-feature">
            <dt>
              <details class="group">
                <summary class="flex items-center justify-between cursor-pointer list-none p-4 text-heading-md text-text-primary">
                  How accurate are the sentence and paragraph counts?
                  <Icon name="arrowRight" width="20" height="20" class="text-text-muted group-open:rotate-90 transition-transform" />
                </summary>
                <dd class="px-4 pb-4 text-body-md text-text-secondary prose-full">
                  Sentences are detected by punctuation (.!?), paragraphs by double newlines. Results follow standard text analysis conventions and match industry-standard tools.
                </dd>
              </details>
            </dt>
          </div>

          <div class="card-feature">
            <dt>
              <details class="group">
                <summary class="flex items-center justify-between cursor-pointer list-none p-4 text-heading-md text-text-primary">
                  Does the Word Counter work offline?
                  <Icon name="arrowRight" width="20" height="20" class="text-text-muted group-open:rotate-90 transition-transform" />
                </summary>
                <dd class="px-4 pb-4 text-body-md text-text-secondary prose-full">
                  Yes. After initial load, it works completely offline as a PWA. All processing happens in your browser, no network requests for text analysis.
                </dd>
              </details>
            </dt>
          </div>

          <div class="card-feature">
            <dt>
              <details class="group">
                <summary class="flex items-center justify-between cursor-pointer list-none p-4 text-heading-md text-text-primary">
                  Is there a limit on text length?
                  <Icon name="arrowRight" width="20" height="20" class="text-text-muted group-open:rotate-90 transition-transform" />
                </summary>
                <dd class="px-4 pb-4 text-body-md text-text-secondary prose-full">
                  No limit on pasted/typed text. File uploads limited to 10MB each (TXT, MD, PDF, DOCX). The tool handles very large texts efficiently without performance issues.
                </dd>
              </details>
            </dt>
          </div>
        </dl>
      </div>
    </section>

    <Footer />
  </main>

  <script is:inline>
    (function() {
      'use strict';

      const STORAGE_KEY = 'word-counter-text';
      const textarea = document.getElementById('text-input');
      const fileInput = document.getElementById('file-input');
      const dropZone = document.getElementById('drop-zone');
      const fileInfo = document.getElementById('file-info');
      const fileName = document.getElementById('file-name');
      const fileSize = document.getElementById('file-size');
      const removeFileBtn = document.getElementById('remove-file-btn');
      const clearBtn = document.getElementById('clear-btn');
      const copyStatsBtn = document.getElementById('copy-stats-btn');
      const copyTextBtn = document.getElementById('copy-text-btn');
      const downloadStatsBtn = document.getElementById('download-stats-btn');
      const statsLoading = document.getElementById('stats-loading');
      const statsContent = document.getElementById('stats-content');
      const toast = document.getElementById('toast');

      const statElements = {
        words: document.getElementById('stat-words'),
        chars: document.getElementById('stat-chars'),
        charsNoSpaces: document.getElementById('stat-chars-no-spaces'),
        sentences: document.getElementById('stat-sentences'),
        paragraphs: document.getElementById('stat-paragraphs'),
        lines: document.getElementById('stat-lines'),
        avgWord: document.getElementById('stat-avg-word'),
        avgSentence: document.getElementById('stat-avg-sentence'),
      };

      const textView = document.getElementById('text-view');
      const pdfView = document.getElementById('pdf-view');
      const pdfCanvas = document.getElementById('pdf-canvas');
      const pdfLoading = document.getElementById('pdf-loading');
      const pdfError = document.getElementById('pdf-error');
      const pdfPrev = document.getElementById('pdf-prev');
      const pdfNext = document.getElementById('pdf-next');
      const pdfPageInfo = document.getElementById('pdf-page-info');
      const pdfZoom = document.getElementById('pdf-zoom');

      let pdfDoc = null;
      let pdfPageNum = 1;
      let pdfScale = 1;

      function showToast(message, isError = false) {
        toast.textContent = message;
        toast.classList.remove('hidden', 'toast-error', 'toast-success');
        toast.classList.add(isError ? 'toast-error' : 'toast-success');
        setTimeout(() => toast.classList.add('hidden'), 3000);
      }

      function formatNumber(num) {
        return num.toLocaleString();
      }

      function updateStats(text) {
        const trimmed = text.trim();

        if (!trimmed) {
          Object.values(statElements).forEach(el => el.textContent = '0');
          statsLoading.classList.remove('hidden');
          statsContent.classList.add('hidden');
          dropZone.classList.remove('hidden');
          return;
        }

        statsLoading.classList.add('hidden');
        statsContent.classList.remove('hidden');
        dropZone.classList.add('hidden');

        const lines = trimmed.split('\n');
        const lineCount = lines.length;

        const paragraphs = trimmed.split(/\n\s*\n/).filter(p => p.trim().length > 0);
        const paragraphCount = paragraphs.length;

        const words = trimmed.match(/\b\w+\b/g) || [];
        const wordCount = words.length;

        const characters = trimmed.length;
        const charactersNoSpaces = trimmed.replace(/\s/g, '').length;

        const sentences = trimmed.match(/[.!?]+(?:\s+|$)/g) || [];
        const sentenceCount = sentences.length || (wordCount > 0 ? 1 : 0);

        const avgWordLength = wordCount > 0
          ? words.reduce((sum, w) => sum + w.length, 0) / wordCount
          : 0;

        const avgSentenceLength = sentenceCount > 0
          ? wordCount / sentenceCount
          : 0;

        statElements.words.textContent = formatNumber(wordCount);
        statElements.chars.textContent = formatNumber(characters);
        statElements.charsNoSpaces.textContent = formatNumber(charactersNoSpaces);
        statElements.sentences.textContent = formatNumber(sentenceCount);
        statElements.paragraphs.textContent = formatNumber(paragraphCount);
        statElements.lines.textContent = formatNumber(lineCount);
        statElements.avgWord.textContent = avgWordLength.toFixed(2);
        statElements.avgSentence.textContent = avgSentenceLength.toFixed(2);
      }

      async function loadPdf(file) {
        pdfLoading.classList.remove('hidden');
        pdfError.classList.add('hidden');
        const container = document.getElementById('pdf-container');
        container.innerHTML = '';

        try {
          const arrayBuffer = await file.arrayBuffer();
          const pdfjsLib = await import('https://unpkg.com/pdfjs-dist@4.0.379/build/pdf.mjs');
          pdfjsLib.GlobalWorkerOptions.workerSrc = `https://unpkg.com/pdfjs-dist@4.0.379/build/pdf.worker.min.mjs`;

          pdfDoc = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
          await renderAllPages();
        } catch (error) {
          console.error('PDF loading error:', error);
          pdfLoading.classList.add('hidden');
          pdfError.classList.remove('hidden');
        }
      }

      async function renderAllPages() {
        if (!pdfDoc) return;

        pdfLoading.classList.remove('hidden');
        pdfError.classList.add('hidden');
        const container = document.getElementById('pdf-container');
        container.innerHTML = '';

        try {
          const isDark = document.documentElement.classList.contains('dark');
          const dpr = window.devicePixelRatio || 1;

          // Get container width for proper layout (subtract padding)
          const containerRect = container.getBoundingClientRect();
          const containerWidth = containerRect.width - 32; // 16px padding each side

          for (let pageNum = 1; pageNum <= pdfDoc.numPages; pageNum++) {
            const page = await pdfDoc.getPage(pageNum);

            // Get page's natural viewport at scale 1.0 to determine aspect ratio
            const naturalViewport = page.getViewport({ scale: 1.0 });
            const pageAspectRatio = naturalViewport.width / naturalViewport.height;

            // Calculate display width based on container, then scale height to preserve aspect ratio
            // Use pdfScale as a multiplier on the base display size
            const baseDisplayWidth = Math.min(containerWidth, naturalViewport.width * pdfScale);
            const displayWidth = baseDisplayWidth;
            const displayHeight = displayWidth / pageAspectRatio;

            // Render at high DPI for crispness
            const renderScale = (displayWidth * dpr) / naturalViewport.width;
            const renderViewport = page.getViewport({ scale: renderScale });

            const canvas = document.createElement('canvas');
            canvas.className = 'pdf-page-canvas mx-auto block';
            if (isDark) {
              canvas.classList.add('pdf-dark-mode');
            }
            canvas.width = renderViewport.width;
            canvas.height = renderViewport.height;
            // CSS size for display (maintains aspect ratio)
            canvas.style.width = `${displayWidth}px`;
            canvas.style.height = `${displayHeight}px`;

            const context = canvas.getContext('2d');
            context.imageSmoothingEnabled = true;
            context.imageSmoothingQuality = 'high';

            await page.render({ canvasContext: context, viewport: renderViewport }).promise;

            // Wrap in div for proper spacing
            const pageWrapper = document.createElement('div');
            pageWrapper.className = 'pdf-page-wrapper';
            pageWrapper.appendChild(canvas);
            container.appendChild(pageWrapper);
          }

          pdfPageInfo.textContent = `${pdfDoc.numPages} page${pdfDoc.numPages > 1 ? 's' : ''}`;
          pdfLoading.classList.add('hidden');
        } catch (error) {
          console.error('PDF rendering error:', error);
          pdfLoading.classList.add('hidden');
          pdfError.classList.remove('hidden');
        }
      }

      function applyDarkModeToPdf(isDark) {
        const canvases = document.querySelectorAll('#pdf-container canvas');
        canvases.forEach(canvas => {
          if (isDark) {
            canvas.classList.add('pdf-dark-mode');
          } else {
            canvas.classList.remove('pdf-dark-mode');
          }
        });
      }

      const zoomInBtn = document.getElementById('zoom-in');
      const zoomOutBtn = document.getElementById('zoom-out');
      const zoomInput = document.getElementById('pdf-zoom');

      function updateZoomDisplay() {
        zoomInput.value = Math.round(pdfScale * 100);
      }

      function applyZoom(newScale) {
        const oldScale = pdfScale;
        pdfScale = Math.max(0.5, Math.min(3, newScale));
        updateZoomDisplay();
        
        // Scale existing canvases by the RATIO of new/old scale
        const ratio = pdfScale / oldScale;
        const canvases = document.querySelectorAll('#pdf-container canvas');
        canvases.forEach(canvas => {
          const currentWidth = parseFloat(canvas.style.width) || canvas.width;
          const currentHeight = parseFloat(canvas.style.height) || canvas.height;
          canvas.style.width = `${currentWidth * ratio}px`;
          canvas.style.height = `${currentHeight * ratio}px`;
        });
      }

      zoomInBtn.addEventListener('click', () => {
        applyZoom(pdfScale * 1.2);
      });

      zoomOutBtn.addEventListener('click', () => {
        applyZoom(pdfScale / 1.2);
      });

      zoomInput.addEventListener('change', (e) => {
        const newScale = parseFloat(e.target.value) / 100;
        if (!isNaN(newScale)) {
          applyZoom(newScale);
        }
      });

      zoomInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          zoomInput.blur();
        }
      });

      // Listen for theme changes to update PDF dark mode
      const themeObserver = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          if (mutation.attributeName === 'class') {
            const isDark = document.documentElement.classList.contains('dark');
            applyDarkModeToPdf(isDark);
          }
        }
      });
      themeObserver.observe(document.documentElement, { attributes: true });

      function saveToStorage(text) {
        try {
          localStorage.setItem(STORAGE_KEY, text);
        } catch (e) {}
      }

      function loadFromStorage() {
        try {
          return localStorage.getItem(STORAGE_KEY) || '';
        } catch (e) {
          return '';
        }
      }

      function clearAll() {
        textarea.value = '';
        saveToStorage('');
        updateStats('');
        fileInput.value = '';
        fileInfo.classList.add('hidden');
        dropZone.classList.remove('hidden');
        textView.classList.remove('hidden');
        pdfView.classList.add('hidden');
        pdfDoc = null;
        pdfPageNum = 1;
        showToast('Text cleared');
      }

      async function handleFile(file) {
        const { validateFile, readFileContent } = await import('/scripts/file-reader.js?v=3');
        const validation = validateFile(file);
        if (!validation.valid) {
          showToast(validation.error, true);
          return;
        }

        dropZone.classList.add('hidden');
        fileName.textContent = file.name;
        fileSize.textContent = formatFileSize(file.size);
        fileInfo.classList.remove('hidden');

        try {
          const text = await readFileContent(file);
          textarea.value = text;
          saveToStorage(text);
          updateStats(text);
          showToast('File loaded successfully');
          hideHeroSection();

          const isPdf = file.name.toLowerCase().endsWith('.pdf');
          if (isPdf) {
            textView.classList.add('hidden');
            pdfView.classList.remove('hidden');
            await loadPdf(file);
          } else {
            textView.classList.remove('hidden');
            pdfView.classList.add('hidden');
          }
        } catch (error) {
          showToast('Failed to read file: ' + error.message, true);
          fileInfo.classList.add('hidden');
          dropZone.classList.remove('hidden');
        }
      }

      function formatFileSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
      }

      async function copyStats() {
        const stats = {
          words: statElements.words.textContent,
          characters: statElements.chars.textContent,
          charactersNoSpaces: statElements.charsNoSpaces.textContent,
          sentences: statElements.sentences.textContent,
          paragraphs: statElements.paragraphs.textContent,
          lines: statElements.lines.textContent,
          averageWordLength: statElements.avgWord.textContent,
          averageSentenceLength: statElements.avgSentence.textContent,
        };

        try {
          await navigator.clipboard.writeText(JSON.stringify(stats, null, 2));
          showToast('Statistics copied to clipboard');
        } catch (e) {
          showToast('Failed to copy', true);
        }
      }

      async function copyText() {
        try {
          await navigator.clipboard.writeText(textarea.value);
          showToast('Text copied to clipboard');
        } catch (e) {
          showToast('Failed to copy', true);
        }
      }

      function downloadStats() {
        const stats = {
          words: parseInt(statElements.words.textContent.replace(/,/g, ''), 10),
          characters: parseInt(statElements.chars.textContent.replace(/,/g, ''), 10),
          charactersNoSpaces: parseInt(statElements.charsNoSpaces.textContent.replace(/,/g, ''), 10),
          sentences: parseInt(statElements.sentences.textContent.replace(/,/g, ''), 10),
          paragraphs: parseInt(statElements.paragraphs.textContent.replace(/,/g, ''), 10),
          lines: parseInt(statElements.lines.textContent.replace(/,/g, ''), 10),
          averageWordLength: parseFloat(statElements.avgWord.textContent),
          averageSentenceLength: parseFloat(statElements.avgSentence.textContent),
          timestamp: new Date().toISOString(),
        };

        const blob = new Blob([JSON.stringify(stats, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'word-count-stats.json';
        a.click();
        URL.revokeObjectURL(url);
        showToast('Statistics downloaded');
      }

      let debounceTimer = null;
      function debouncedUpdate(text) {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          updateStats(text);
          saveToStorage(text);
        }, 100);
      }

      textarea.addEventListener('input', (e) => {
        debouncedUpdate(e.target.value);
        if (e.target.value.trim()) {
          hideDropZone();
          hideHeroSection();
        }
      });

      clearBtn.addEventListener('click', clearAll);
      copyStatsBtn.addEventListener('click', copyStats);
      copyTextBtn.addEventListener('click', copyText);
      downloadStatsBtn.addEventListener('click', downloadStats);

      removeFileBtn.addEventListener('click', () => {
        fileInput.value = '';
        fileInfo.classList.add('hidden');
        if (!textarea.value.trim()) {
          dropZone.classList.remove('hidden');
        }
      });

      fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) handleFile(file);
      });

      function showDropZone() {
        dropZone.classList.remove('hidden');
        dropZone.style.borderColor = 'var(--color-text-primary)';
        dropZone.style.backgroundColor = 'var(--color-border-soft)';
      }

      function hideDropZone() {
        dropZone.classList.add('hidden');
        dropZone.style.borderColor = '';
        dropZone.style.backgroundColor = '';
      }

      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        showDropZone();
      });

      dropZone.addEventListener('dragleave', (e) => {
        e.preventDefault();
        if (!dropZone.contains(e.relatedTarget)) {
          hideDropZone();
        }
      });

      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        hideDropZone();
        const file = e.dataTransfer.files[0];
        if (file) handleFile(file);
      });

      textarea.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (!textarea.value.trim()) {
          showDropZone();
        }
      });

      textarea.addEventListener('dragleave', (e) => {
        if (!textarea.contains(e.relatedTarget)) {
          hideDropZone();
        }
      });

      textarea.addEventListener('drop', (e) => {
        e.preventDefault();
        hideDropZone();
        const file = e.dataTransfer.files[0];
        if (file) handleFile(file);
      });

      const uploadBtn = document.getElementById('upload-btn');
      uploadBtn.addEventListener('click', () => {
        fileInput.click();
      });

      // Hero section hide logic
      const heroSection = document.querySelector('[aria-labelledby="hero-heading"]');
      function hideHeroSection() {
        if (heroSection && !heroSection.classList.contains('hidden')) {
          heroSection.classList.add('hidden');
        }
      }

      // Clear stored text on page load for privacy
      localStorage.removeItem('word-counter-text');
      updateStats('');

      textarea.focus();

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    })();
  </script>
</Layout>